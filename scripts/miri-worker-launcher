#!/bin/bash
set -euo pipefail

CONTENTS=$(cd "$(dirname "$0")/.." && pwd)
export PYTHONPATH="$CONTENTS/Resources/worker"
# A signed macOS app bundle must remain immutable after installation. Python's
# default __pycache__ writes would otherwise invalidate the bundle seal after
# the first worker launch.
export PYTHONDONTWRITEBYTECODE=1
PYTHON="$CONTENTS/Resources/python/bin/python3"
if [[ ! -x "$PYTHON" ]]; then PYTHON="$CONTENTS/Resources/python/install/bin/python3"; fi
exec "$PYTHON" -s -m miri_worker.service "$@"
